# =================================================================
# OnboardFlow SaaS - Unified Environment Configuration Template
# =================================================================

# ----------------- Application Settings -----------------
APP_NAME="OnboardFlow Enterprise SaaS"
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=your-super-secret-key-32-chars-minimum

# ----------------- Backend FastAPI Configuration -----------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5000","https://onboardflow.vercel.app","https://onboardflow.onrender.com"]

# ----------------- Frontend Flask Configuration -----------------
FRONTEND_PORT=5000
BACKEND_URL=http://localhost:8000

# ----------------- Oracle Database (SQLAlchemy + Thin Mode) -----------------
ORACLE_USER=system
ORACLE_PASSWORD=your_secure_oracle_password
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=xe
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ----------------- Cloudinary Storage -----------------
CLOUDINARY_CLOUD_NAME=onboardflow-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ----------------- NodeMailer / SMTP Notifications -----------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.onboardflow.io
SMTP_PASSWORD=your_smtp_password
NOTIFICATION_SENDER="OnboardFlow Alerts <notifications@onboardflow.io>"
